# =============================================================================
# Python & Environment Ignore Rules
# =============================================================================
venv/
**/venv/
.venv/
**/.venv/
env/
**/env/

# Byte-compiled / optimized / DLL files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyd

# =============================================================================
# Audio & Video Media Cache (Storage)
# =============================================================================
**/storage/uploads/*
!**/storage/uploads/.gitignore
!**/storage/uploads/.gitkeep

**/storage/outputs/*
!**/storage/outputs/.gitignore
!**/storage/outputs/.gitkeep

*.mp3
*.mp4
*.wav
*.m4a
*.mov
*.mkv
*.avi
*.webm
*.flac

# =============================================================================
# Machine Learning Checkpoints & Datasets (Stage 4)
# =============================================================================
**/saved_model/
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.pdf
*.docx

# =============================================================================
# OS & Editor Artifacts
# =============================================================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/