NATIVOX_DEVICE=cpu
NATIVOX_TTS=free

# Optional Sarvam API key (leave blank to run in 100% Free / Zero-API mode)
SARVAM_API_KEY=

# Wav2Lip configuration: specify absolute or relative paths
WAV2LIP_REPO=models/wav2lip
WAV2LIP_CHECKPOINT=models/wav2lip/checkpoints/wav2lip_gan.pth

# Optional custom python executable override (if not using local .venv or active environment)
# LIPSYNC_PYTHON=

# Optional external Pipeline2 or OpenVoice directory overrides
# PIPELINE2_DIR=
# OPENVOICE_REPO=models/openvoice/OpenVoice
# OPENVOICE_CHECKPOINTS=models/openvoice/checkpoints_v2/converter
